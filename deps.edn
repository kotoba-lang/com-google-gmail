{:paths ["src"]
 ;; The connector kernel is the only dependency. It carries the descriptor
 ;; model, the OAuth flow and the invoke path; this repository carries the two
 ;; things that are specific to one service -- how a tool call becomes a
 ;; request, and how a response becomes a result.
 :deps {io.github.kotoba-lang/connector
        {:git/url "https://github.com/kotoba-lang/connector"
         :git/sha "189dd753d7f3d7fc0e1ce00bcf3ff52ed9621da6"}}
 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test"
                     "--fail-level" "error"]}}}
